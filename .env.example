# GEMINI_API_KEY: Required for multimodal defect analysis and root-cause intelligence.
# Server-side only. AI Studio injects this or provide your Google AI Studio API key.
GEMINI_API_KEY="your-gemini-api-key-here"

# APP_URL: Base URL of the deployment (e.g., https://your-domain.run.app)
APP_URL="http://localhost:3000"

# PORT: Server listening port (default: 3000)
PORT="3000"

# NODE_ENV: Application environment (development | production)
NODE_ENV="production"

# SUPABASE_URL: Supabase PostgreSQL & Storage project URL
# Client & Server (also exposed as VITE_SUPABASE_URL if using client SDK directly)
SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# SUPABASE_ANON_KEY: Client-safe publishable anonymous key with Row-Level Security enforcement
SUPABASE_ANON_KEY="your-anon-public-key"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# SUPABASE_SERVICE_ROLE_KEY: Elevated server-side service key (CRITICAL: NEVER PREFIX WITH VITE_)
# Used exclusively by backend API router for administrative migrations and webhook execution
SUPABASE_SERVICE_ROLE_KEY="your-server-service-role-key"
